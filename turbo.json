{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "next:build": {
      "dependsOn": ["^next:build", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "next:dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["lint", "typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["db:generate"],
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "format:write": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:migrate:local": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
